 "msgs": [
  {
   "id": "m1",
   "f": "u",
   "to": "app",
   "l": "enters phone, consents",
   "what": "The bureau step. **Simulated** for the demo: say it in the voiceover, not on screen. Phone 98765 04569 brings up HDFC Millennia and SBI Cashback.",
   "t": "NEW"
  },
  {
   "id": "m2",
   "f": "app",
   "to": "api",
   "l": "POST /me/discovery/bureau/start",
   "what": "Starts a fetch and returns a request id. The app fills the code in, as SMS autofill would.",
   "code": "{\"phone\":\"9876504569\",\"consent\":true}",
   "t": "NEW",
   "hl": "otp"
  },
  {
   "id": "m3",
   "f": "app",
   "to": "api",
   "l": "POST /me/discovery/bureau/verify",
   "what": "The feed names each **exact card**, when it was opened, its limit and balance. The fee shown comes from our card catalogue. No \"Which card is this?\" step.",
   "t": "NEW",
   "code": "{\"card_id\":\"hdfc_millennia\",\"card_name\":\"HDFC Bank Millennia Credit Card\",\n \"opened\":\"2021-08-26\",\"credit_limit_paise\":8000000,\"current_balance_paise\":2050000}",
   "hl": "cards"
  },
  {
   "id": "m4",
   "f": "app",
   "to": "api",
   "l": "PUT /me/holdings",
   "what": "Add these cards: limit, balance, and the fee month from the open date. Each card's fee can later be set to Standard, LTF, FYF or Custom; Finder and Notices use a custom amount.",
   "code": "[{\"card_id\":\"hdfc_millennia\",\"renewal_month\":8,\"fee_status\":\"standard\",...}]",
   "t": "MOD",
   "hl": "add"
  },
  {
   "id": "m5",
   "f": "app",
   "to": "api",
   "l": "POST /me/budget/import-demo",
   "what": "Reads last month's transactions (simulated SMS and email) and fills the budget from them. Totals vary a little per account.",
   "hl": "sms",
   "code": "{\"sources\":[\"sms\",\"email\"]}",
   "t": "NEW"
  },
  {
   "f": "api",
   "hl": "budget",
   "id": "m6",
   "l": "budget, editable and self-adapting",
   "res": true,
   "to": "app",
   "what": "Unpinned lines follow last month's actuals each new month; edited lines stay. Reward type and fee limit are not asked here: Card Finder asks them on its first visit."
  }
 ]
