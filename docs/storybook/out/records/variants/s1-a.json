  },
  {
   "id": "m3",
   "f": "app",
   "to": "api",
   "l": "GET /cards",
   "what": "The catalogue: 22 cards with fee, reward type and as-of date.",
   "t": "OLD",
   "hl": "held"
  },
  {
   "id": "m4",
   "f": "u",
   "to": "app",
   "l": "ticks Millennia, sets shared limit",
   "what": "Most banks give one limit across all your cards with them, so the sheet offers **Shares a limit** next to **Own limit**.",
   "hl": "pool"
  },
  {
   "id": "m5",
   "f": "app",
   "to": "api",
   "l": "PUT /me/pools",
   "what": "The pool is saved first, so the cards can point at it.",
   "code": "[{\"id\":\"hdfc\",\"name\":\"HDFC shared\",\"limit_paise\":20000000}]",
   "t": "NEW",
   "hl": "pool"
  },
  {
   "id": "m6",
   "f": "app",
   "to": "api",
   "l": "PUT /me/holdings",
